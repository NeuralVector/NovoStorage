{
	"name": "novostorage",
	"private": "true",
	"bugs": {
		"url": "https://github.com/NeuralVector/NovoStorage/issues",
		"email": "rashinkar.anish@gmail.com"
	},
	"license": "UNLICENSED",
	"author": {
		"name": "NeuralVector (GitHub)",
		"email": "rashinkar.anish@gmail.com",
		"url": "https://github.com/NeuralVector"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeuralVector/NovoStorage.git"
	},
	"type": "module",
	"imports": {
		"#app": "./src/app.ts",
		"#app-module": "./src/app.module.ts",
		"#config": "./src/config.ts",
		"#controllers/*": "./src/controllers/*",
		"#services/*": "./src/services/*",
		"#utils/*": "./src/utils/*"
	},
	"scripts": {
		"dev": "varlock run -- sh -c 'ROLLDOWN_DEV=true node --import=tsx/esm node_modules/rolldown/dist/cli.mjs -c --watch & frontend_pid=$!; trap \"kill $frontend_pid\" EXIT; exec node --import=tsx/esm --watch src/server.ts'",
		"dev:bun": "varlock run -- sh -c 'ROLLDOWN_DEV=true bun node_modules/rolldown/dist/cli.mjs -c --watch & frontend_pid=$!; trap \"kill $frontend_pid\" EXIT; exec bun --watch src/server.ts'",
		"build": "varlock run -- sh -c 'rm -rf dist && node --import=tsx/esm node_modules/rolldown/dist/cli.mjs -c && cp -r public/* dist/public/'",
		"start": "varlock run -- node dist/server.js",
		"start:bun": "varlock run -- bun dist/server.js"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1126.0",
		"@clerk/clerk-js": "^6.31.0",
		"@clerk/fastify": "^3.1.76",
		"@fastify/multipart": "^10.1.1",
		"@fastify/static": "^10.1.3",
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-fastify": "^12.0.1",
		"convict": "^6.2.5",
		"fastify": "^5.12.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@types/convict": "^6.1.6",
		"@types/node": "^26.4.1",
		"@varlock/infisical-plugin": "^2.1.1",
		"fast-glob": "^3.3.3",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"pino-pretty": "^13.1.3",
		"rolldown": "^1.2.7",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"varlock": "^1.18.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=11",
			"onFail": "warn"
		}
	}
}
